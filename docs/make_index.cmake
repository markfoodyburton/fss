# Generate docs/index.html linking every rendered HTML.
# Invoked by docs/CMakeLists.txt as a custom command.

file(WRITE ${DOCS_OUT}/index.html [=[
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>FSS — Federated Simulation Standard</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, sans-serif;
         max-width: 780px; margin: 2em auto; padding: 0 1em; color: #1f2933; }
  h1 { border-bottom: 2px solid #2d3748; padding-bottom: .25em; }
  h2 { color: #2d3748; margin-top: 2em; }
  ul { line-height: 1.7; }
  a  { color: #2563eb; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .tag { display: inline-block; padding: .1em .5em; border-radius: 3px;
         font-size: .8em; vertical-align: middle; }
  .normative   { background: #fef3c7; color: #92400e; }
  .design      { background: #dbeafe; color: #1e40af; }
  .top         { background: #d1fae5; color: #065f46; }
</style>
</head>
<body>

<h1>FSS — Federated Simulation Standard</h1>

<p>Rendered documentation index.  Source markdown is in the repo;
this page is generated by the CMake build.</p>

<h2>Top-level</h2>
<ul>
  <li><a href="README.html">README</a> <span class="tag top">top</span></li>
  <li><a href="REPORT.html">REPORT</a> <span class="tag top">top</span></li>
</ul>

<h2>Specification (normative)</h2>
<ul>
]=])

file(GLOB SPEC_MDS ${SRC_DIR}/spec/*.md)
foreach(MD IN LISTS SPEC_MDS)
    get_filename_component(BASENAME ${MD} NAME_WE)
    file(APPEND ${DOCS_OUT}/index.html
        "  <li><a href=\"spec/${BASENAME}.html\">${BASENAME}</a> <span class=\"tag normative\">normative</span></li>\n")
endforeach()

file(APPEND ${DOCS_OUT}/index.html [=[
</ul>

<h2>Design notes</h2>
<ul>
]=])

file(GLOB DESIGN_MDS ${SRC_DIR}/design/*.md)
foreach(MD IN LISTS DESIGN_MDS)
    get_filename_component(BASENAME ${MD} NAME_WE)
    file(APPEND ${DOCS_OUT}/index.html
        "  <li><a href=\"design/${BASENAME}.html\">${BASENAME}</a> <span class=\"tag design\">design</span></li>\n")
endforeach()

file(APPEND ${DOCS_OUT}/index.html [=[
</ul>

</body>
</html>
]=])
